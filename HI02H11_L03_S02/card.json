  "audio_text": {
   "vo_bridge_lost": "ये कविता सुनकर मुझे तो बहुत मज़ा आया, लेकिन मेले में भीड़ की वजह से सभी जोड़ियाँ बिछड़ गईं। आइए साथ मिलकर ढूँढ़ते हैं। चलिए, साथ में करें!",
   "vo_c_sentence": "शाबाश! सही वाक्य है— बकरा घास खा रहा है।",
   "vo_correct_pair": "शाबाश! आपने सही जोड़ी मिला दी।",
   "vo_match_pairs": "हर जानवर को उसकी सही जोड़ी से मिलाइए।",
   "vo_correct_pairs": "शाबाश! आपने सभी सही जोड़ियाँ मिला दीं।",
   "vo_h1_mor": "सोचिए, मोर मेले में किसके साथ आया था?",
   "vo_h1_bakri": "सोचिए, बकरी मेले में किसके साथ आई थी?",
   "vo_h1_ghoda": "सोचिए, घोड़ा मेले में किसके साथ आया था?",
   "vo_h1_pair": "फिर से कोशिश कीजिए, सही जोड़ी पहचानिए।",
   "vo_h1_sentence": "सोचिए, वाक्य में रहा है आएगा या रही है आएगा?",
   "vo_h1_sherni": "सोचिए, शेरनी मेले में किसके साथ आई थी?",
   "vo_h2_bail": "यह बैल है, इसे गाय से मिलाएंगे। गाय के चित्र पर टैप कीजिए।",
   "vo_h2_bakri": "बैल, बकरा, शेरनी",
   "vo_h2_bandar": "यह बंदर है, इसे बंदरिया से मिलाएंगे। बंदरिया के चित्र पर टैप कीजिए।",
   "vo_h2_ghoda": "गाय, मुर्गी, घोड़ी",
   "vo_h2_mor": "बंदरिया, मोरनी, मुर्गी",
   "vo_h2_murga": "यह मुर्गा है, इसे मुर्गी से मिलाएंगे। मुर्गी के चित्र पर टैप कीजिए।",
   "vo_h2_sherni": "बैल, शेर, घोड़ा",
   "vo_landing": "नमस्ते दोस्त, मैं हूँ swiftee, आज हम शब्दों की जोड़ियाँ मिलाएंगे।",
   "vo_name_bail": "बैल",
   "vo_name_bakra": "बकरा",
   "vo_name_bakri": "बकरी",
   "vo_name_bandar": "बंदर",
   "vo_name_bandariya": "बंदरिया",
   "vo_name_gaay": "गाय",
   "vo_name_ghoda": "घोड़ा",
   "vo_name_ghodi": "घोड़ी",
   "vo_name_mor": "मोर",
   "vo_name_morni": "मोरनी",
   "vo_name_murga": "मुर्गा",
   "vo_name_murgi": "मुर्गी",
   "vo_name_sher": "शेर",
   "vo_name_sherni": "शेरनी",
   "vo_poem_01": "पहले हम एक कविता पढ़ेंगे - जंगल का मेला। जंगल में एक मेला आया, रंग-बिरंगा खूब सजाया।",
   "vo_poem_02": "शेर आया, शेरनी आई, दोनों ने मिलकर धूम मचाई।",
   "vo_poem_03": "मोर पंख रंगीन फैलाए, मोरनी संग ठुमके लगाए।",
   "vo_poem_04": "घोड़ा आया धूल उड़ाए, घोड़ी पीछे दौड़ी आए।",
   "vo_poem_05": "बकरा बोला, “में-में-में” बकरी बोली, “साथ चले।”",
   "vo_poem_06": "बंदर लाया लाल गुब्बारा, बंदरिया बोली, “कितना प्यारा।”",
   "vo_poem_07": "मुर्गा बोला, “कुकड़ू-कूँ” मुर्गी बोली, “क्या खाऊँ?”",
   "vo_poem_08": "बैल ने जब ढोल बजाया, गाय ने भी नाच दिखाया।",
   "vo_poem_09": "सूरज ढलते शाम हुई, मेले भर में धूम हुई।",
   "vo_pt_guided": "बहुत बढ़िया! अब हम साथ मिलकर शुरू करते हैं। चलिए, साथ में करें!",
   "vo_pt_practice": "वाह! अब आपकी बारी।",
   "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
   "vo_q_bakri_new": "बकरी मेले में किसके साथ आई थी?",
   "vo_q_ghoda_new": "घोड़ा मेले में किसके साथ आया था?",
   "vo_q_mor": "मोर मेले में किसके साथ आया था?",
   "vo_q_sentence": "सही शब्द चुनकर वाक्य पूरा कीजिए। बकरा घास खा… रहा है या रही है?",
   "vo_q_sherni": "शेरनी मेले में किसके साथ आई थी?",
   "vo_well_done": "शाबाश! आपने सभी सही जोड़ियाँ पहचान लीं।",
   "vo_h1_sentence_bandar": "सोचिए, वाक्य में चढ़ता है आएगा या चढ़ती है आएगा?",
   "vo_h1_sentence_sherni": "सोचिए, वाक्य में जाता है आएगा या जाती है आएगा?",
   "vo_h2_sentence": "हम वाक्य में बोलते हैं, बकरा घास खा रहा है।",
   "vo_h2_sentence_bandar": "हम वाक्य में बोलते हैं, बंदर पेड़ पर चढ़ता है।",
   "vo_h2_sentence_sherni": "हम वाक्य में बोलते हैं, शेरनी मेले में जाती है।",
   "vo_h3_bakri": "यह बकरा है, यह सही उत्तर है, इसपर टैप कीजिए।",
   "vo_h3_ghoda": "यह घोड़ी शब्द है, यह सही उत्तर है, इसपर टैप कीजिए।",
   "vo_h3_mor": "यह मोरनी है, यह सही उत्तर है, इसपर टैप कीजिए।",
   "vo_h3_sentence": "रहा है पर टैप कीजिए और वाक्य पूरा कीजिए।",
   "vo_h3_sentence_bandar": "चढ़ता है पर टैप कीजिए और वाक्य पूरा कीजिए।",
   "vo_h3_sentence_sherni": "जाती है पर टैप कीजिए और वाक्य पूरा कीजिए।",
   "vo_h3_sherni": "यह शेर है, यह सही उत्तर है, इसपर टैप कीजिए।",
   "vo_wq_bakra": "बकरे की जोड़ी को चुनिए और उसके साथ झूले पर बैठाइए।",
   "vo_wq_chuhiya": "चुहिया की जोड़ी को चुनिए और उसके साथ झूले पर बैठाइए।",
