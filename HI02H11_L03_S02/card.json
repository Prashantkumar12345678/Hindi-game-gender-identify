  "audio_text": {
   "vo_bridge_lost": "क्या आपको कविता सुनकर मज़ा आया? मेले में भीड़ की वजह से सभी जोड़ियाँ बिछड़ गईं। क्या आप सही जोड़ियाँ ढूँढने में मेरी मदद करेंगे? आइए साथ मिलकर ढूँढ़ते हैं।",
   "vo_c_sentence": "शाबाश! सही वाक्य है— बकरा घास खा रहा है।",
   "vo_correct_pair": "शाबाश! आपने सही जोड़ी मिला दी।",
   "vo_match_pairs": "हर जानवर को उसकी सही जोड़ी से मिलाइए।", "vo_bridge_lost": "ये कविता सुनकर मुझे तो बहुत मज़ा आया, लेकिन मेले में भीड़ की वजह से सभी जोड़ियाँ बिछड़ गईं। आइए साथ मिलकर सभी जोड़ियाँ ढूँढ़ते हैं।", "vo_gate_done_bakra": "बकरा मेले में गया।", "vo_gate_done_bakri": "बकरी मेले में गई।", "vo_gate_done_bandar": "बंदर मेले में गया।", "vo_gate_done_bandariya": "बंदरिया मेले में गई।", "vo_gate_done_murga": "मुर्गा मेले में गया।", "vo_gate_done_murgi": "मुर्गी मेले में गई।", "vo_gate_done_sher": "शेर मेले में गया।", "vo_gate_done_sherni": "शेरनी मेले में गई।", "vo_h2_bakra_gaya": "यह बकरा है, बकरा मेले में गया। इसे गया वाले गेट से अंदर भेजेंगे।", "vo_h2_bakri_gai": "यह बकरी है, बकरी मेले में गई। इसे गई वाले गेट से अंदर भेजेंगे।", "vo_h2_sher_gaya": "यह शेर है, शेर मेले में गया। इसे गया वाले गेट से अंदर भेजेंगे।", "vo_h2_sherni_gai": "यह शेरनी है, शेरनी मेले में गई। इसे गई वाले गेट से अंदर भेजेंगे।", "vo_correct_pairs": "शाबाश! आपने सभी सही जोड़ियाँ मिला दीं।",
   "vo_gate_h1": "सोचिए इस जानवर के नाम से वाक्य बनाने पर गया आता है या गई?",
   "vo_gate_rule": "यहाँ दो गेट हैं, एक पर गया लिखा है और दूसरे पर गई लिखा है। हर जानवर के नाम से वाक्य बनाकर देखिए — जिनके अंत में गया आता है उन्हें गया वाले गेट से और जिनके अंत में गई आता है उन्हें गई वाले गेट से मेले में भेजिए। जैसे— मुर्गा मेले में गया। इसे गया वाले गेट से भेजिए। अब आप खुद करिए।",
   "vo_h1_bail": "सोचिए बैल मेले में किसके साथ आया था?",
   "vo_h1_mor": "सोचिए मोर मेले में किसके साथ आया था?",
   "vo_h1_bakri": "सोचिए बकरी मेले में किसके साथ आई थी?", "vo_h1_ghoda": "सोचिए घोड़ा मेले में किसके साथ आया था?", "vo_h1_pair": "फिर से कोशिश कीजिए, सही जोड़ी पहचानिए।",
   "vo_h1_sentence": "हम वाक्य में बोलते हैं— बकरा घास खा रहा है। रहा है पर टैप कीजिए और वाक्य पूरा कीजिए।",
   "vo_h1_sherni": "सोचिए शेरनी मेले में किसके साथ आई थी?",
   "vo_h1_word": "फिर से कोशिश कीजिए, सही शब्द पहचानिए।",
   "vo_h2_bail": "यह बैल है, इसे गाय से मिलाएंगे। गाय के चित्र पर टैप कीजिए।",
   "vo_h2_bail_gaay": "बैल मेले में गाय के साथ आया था। गाय के चित्र पर टैप कीजिए।",
   "vo_h2_bakra": "यह बकरा है, इसे बकरी से मिलाएंगे। बकरी के चित्र पर टैप कीजिए।",
   "vo_h2_bakri": "बकरी मेले में बकरे के साथ आई थी। बकरे के चित्र पर टैप कीजिए।",
   "vo_h2_bandar": "यह बंदर है, इसे बंदरिया से मिलाएंगे। बंदरिया के चित्र पर टैप कीजिए।",
   "vo_h2_bandar_gaya": "यह बंदर है, बंदर मेले में गया। इसे गया वाले गेट से अंदर भेजेंगे।",
   "vo_h2_bandariya_gai": "यह बंदरिया है, बंदरिया मेले में गई। इसे गई वाले गेट से अंदर भेजेंगे।",
   "vo_h2_ghoda": "घोड़ा मेले में घोड़ी के साथ आया था। घोड़ी के चित्र पर टैप कीजिए।",
   "vo_h2_ghoda_p": "यह घोड़ा है, इसे घोड़ी से मिलाएंगे। घोड़ी के चित्र पर टैप कीजिए।",
   "vo_h2_mor": "मोर मेले में मोरनी के साथ आया था। मोरनी के चित्र पर टैप कीजिए।",
   "vo_h2_mor_p": "यह मोर है, इसे मोरनी से मिलाएंगे। मोरनी के चित्र पर टैप कीजिए।",
   "vo_h2_murga": "यह मुर्गा है, इसे मुर्गी से मिलाएंगे। मुर्गी के चित्र पर टैप कीजिए।",
   "vo_h2_murga_gaya": "यह मुर्गा है, मुर्गा मेले में गया। इसे गया वाले गेट से अंदर भेजेंगे।",
   "vo_h2_murga_jata": "यह मुर्गा है, मुर्गा जाता है। इसे जाता है वाले डब्बे में रखेंगे।",
   "vo_h2_murgi_gai": "यह मुर्गी है, मुर्गी मेले में गई। इसे गई वाले गेट से अंदर भेजेंगे।",
   "vo_h2_murgi_jati": "यह मुर्गी है, मुर्गी जाती है। इसे जाती है वाले डब्बे में रखेंगे।",
   "vo_h2_sher_jata": "यह शेर है, शेर जाता है। इसे जाता है वाले डब्बे में रखेंगे।",
   "vo_h2_sherni": "शेरनी मेले में शेर के साथ आई थी। शेर के चित्र पर टैप कीजिए।",
   "vo_h2_sherni_jati": "यह शेरनी है, शेरनी जाती है। इसे जाती है वाले डब्बे में रखेंगे।",
   "vo_landing": "नमस्ते दोस्त! मैं हूँ swiftee, आइए आज हम शब्दों की जोड़ियाँ बनाते हैं। जैसे- मोर-मोरनी",
   "vo_name_bail": "बैल",
   "vo_name_bakra": "बकरा",
   "vo_name_bakri": "बकरी",
   "vo_name_bandar": "बंदर",
   "vo_name_bandariya": "बंदरिया",
   "vo_name_gaay": "गाय",
   "vo_name_ghoda": "घोड़ा",
   "vo_name_ghodi": "घोड़ी",
   "vo_name_mor": "मोर",
   "vo_name_morni": "मोरनी",
   "vo_name_murga": "मुर्गा",
   "vo_name_murgi": "मुर्गी",
   "vo_name_sher": "शेर",
   "vo_name_sherni": "शेरनी",
   "vo_poem_01": "आइए आज हम एक कविता सुनते हैं— जंगल का मेला। जंगल में एक मेला आया, रंग-बिरंगा खूब सजाया।",
   "vo_poem_02": "शेर आया, शेरनी आई, दोनों ने मिलकर धूम मचाई।",
   "vo_poem_03": "मोर पंख रंगीन फैलाए, मोरनी संग ठुमके लगाए।",
   "vo_poem_04": "घोड़ा आया धूल उड़ाए, घोड़ी पीछे दौड़ी आए।",
   "vo_poem_05": "बकरा बोला— “में-में-में!” बकरी बोली— “साथ चलें!”",
   "vo_poem_06": "बंदर लाया लाल गुब्बारा, बंदरिया बोली कितना प्यारा!",
   "vo_poem_07": "मुर्गा बोला— “कुकड़ू-कूँ!” मुर्गी बोली— “क्या खाऊँ!”",
   "vo_poem_08": "बैल ने जब ढोल बजाया, गाय ने भी नाच दिखाया।",
   "vo_poem_09": "सूरज ढलते शाम हुई, मेले भर में धूम हुई।",
   "vo_pt_guided": "बहुत बढ़िया! अब हम साथ मिलकर शुरू करते हैं। चलिए, साथ में करें!",
   "vo_pt_practice": "वाह! अब आपकी बारी।",
   "vo_pt_tutorial": "ध्यान से देखिए और मेरे साथ जानिए। चलिए, शुरू करें!",
   "vo_q_bail": "बैल मेले में किसके साथ आया था?",
   "vo_q_bakri": "बकरी मेले में किसके साथ आई थी?",
   "vo_q_ghoda": "घोड़ा मेले में किसके साथ आया था?",
   "vo_q_mor": "मोर मेले में किसके साथ आया था?",
   "vo_q_sentence": "सही शब्द चुनकर वाक्य पूरा कीजिए। बकरा घास खा… रहा है या रही है?",
   "vo_q_sherni": "शेरनी मेले में किसके साथ आई थी?",
